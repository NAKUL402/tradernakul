# ========================================
# TraderNakul AI — Environment Variables
# ========================================
# Copy this file to .env.local and fill in the values.
# DO NOT commit .env.local to git.

# ── Gmail SMTP Configuration ──────────────
# Use a Gmail App Password, NOT your regular Gmail password.
# To generate an App Password:
#   1. Go to: https://myaccount.google.com/security
#   2. Enable 2-Step Verification (if not already enabled)
#   3. Go to: https://myaccount.google.com/apppasswords
#   4. App name: TraderNakul, Generate → copy the 16-char password
EMAIL_USER=nakultrader007@gmail.com
EMAIL_PASS=your_16_char_gmail_app_password_here

# ── Owner Settings ────────────────────────
# Email that receives user approval requests
OWNER_EMAIL=nakultrader007@gmail.com

# ── Site URL ──────────────────────────────
# Used in email approval links — update to your Vercel domain
VITE_SITE_URL=https://tradernakul.vercel.app

# ── Approval Link Security ────────────────
# Secret token to validate approve/reject links in emails
APPROVAL_SECRET=tn-approve-2026
